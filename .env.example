DATABASE_URL="postgresql://wandervibe:wandervibe@localhost:5432/wandervibe"

# Local development only. Generate a real value with: openssl rand -base64 32
# Azure reads this from Key Vault secret auth-secret. Do not put that value here.
AUTH_SECRET="local-dev-only-change-me-not-used-in-azure"

# The dev server and Container Apps both terminate the request on a forwarded host.
AUTH_TRUST_HOST="true"

# Leave empty until you register a provider. Azure stores these in Key Vault.
# See docs/deploy.md for the Entra ID app, the Google client, and the redirect URIs.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# https://login.microsoftonline.com/<tenant-id>/v2.0
# https://login.microsoftonline.com/common/v2.0
# https://login.microsoftonline.com/consumers/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Playwright sets this on its own dev server. Ignored when NODE_ENV=production.
# Set to true if you want the "Sign in as test traveler" button locally.
AUTH_TEST_LOGIN=""
